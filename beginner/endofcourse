}
function checkTF(data, sel, prefix, fbId, exId) {
  let correct = 0;
  data.forEach((item, i) => {
    const tBtn = document.getElementById(`${prefix}t_${i}`);
    const fBtn = document.getElementById(`${prefix}f_${i}`);
