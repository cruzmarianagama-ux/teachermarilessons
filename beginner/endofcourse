// ── MC ──
function buildMC(containerId, data, prefix) {
  const wrap = document.getElementById(containerId);
  data.forEach((item, i) => {
    const div = document.createElement('div'); div.className = 'mc-item';
    div.innerHTML = `<div class="mc-question">${i+1}. ${item.q}</div><div class="mc-options">` +
      item.opts.map((o,j) => `<label class="mc-option" data-q="${prefix}_${i}" data-opt="${j}"><input type="radio" name="${prefix}_${i}" value="${j}"> ${String.fromCharCode(65+j)}) ${o}</label>`).join('') + '</div>';
