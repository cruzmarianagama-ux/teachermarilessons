}
function checkMC(data, prefix, fbId, exId) {
  let correct = 0;
  data.forEach((item, i) => {
    const opts = document.querySelectorAll(`[data-q="${prefix}_${i}"]`);
    opts.forEach(o => o.classList.remove('correct','wrong'));
    const sel = document.querySelector(`input[name="${prefix}_${i}"]:checked`);
    if (sel) {
      const v = parseInt(sel.value);
      opts[v].classList.add(v === item.ans ? 'correct' : 'wrong');
      if (v === item.ans) correct++;
      else opts[item.ans].classList.add('correct');
    } else { opts[item.ans].classList.add('correct'); }
  });
  const r = scoreText(correct, data.length);
  showFeedback(fbId, r.msg, r.type);
  incrementChecked(exId);
}
function resetMC(containerId, prefix, data, fbId) {
