<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>End of Course – Weekly Practice | Teacher Mari</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<style>
  :root {
    --orange: #FF5C23;
    --purple: #1D1050;
    --purple-light: #5340c8;
    --green: #04392F;
    --cream: #FAEAD3;
    --cream-light: #fff8f0;
    --white: #ffffff;
    --gray: #6b7280;
    --gray-light: #f3f4f6;
    --red: #ef4444;
    --teal: #0d9488;
    --radius: 12px;
    --radius-sm: 8px;
    --shadow: 0 4px 20px rgba(29,16,80,0.10);
    --shadow-sm: 0 2px 8px rgba(29,16,80,0.08);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Poppins', sans-serif; background: var(--cream-light); color: var(--purple); min-height: 100vh; }

  /* WELCOME */
  #welcome-screen { position: fixed; inset: 0; background: linear-gradient(135deg, var(--purple) 0%, var(--purple-light) 100%); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 24px; }
  #welcome-screen.hidden { display: none; }
  .welcome-card { background: var(--white); border-radius: 20px; padding: 36px 28px; max-width: 380px; width: 100%; text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,0.3); animation: popIn 0.4s cubic-bezier(.34,1.56,.64,1); }
  @keyframes popIn { from { opacity:0; transform:scale(0.85); } to { opacity:1; transform:scale(1); } }
  .welcome-logo { height: 48px; object-fit: contain; margin-bottom: 16px; }
  .welcome-hi { font-size: 1.5rem; font-weight: 800; color: var(--purple); margin-bottom: 6px; }
  .welcome-sub { font-size: 0.82rem; color: var(--gray); margin-bottom: 24px; line-height: 1.5; }
  .welcome-input { width: 100%; border: 2px solid var(--gray-light); border-radius: var(--radius-sm); padding: 12px 16px; font-family: 'Poppins', sans-serif; font-size: 1rem; font-weight: 600; color: var(--purple); text-align: center; outline: none; margin-bottom: 16px; transition: border-color 0.2s; }
  .welcome-input:focus { border-color: var(--purple-light); }
  .welcome-btn { width: 100%; padding: 13px; background: var(--orange); color: var(--white); border: none; border-radius: 99px; font-family: 'Poppins', sans-serif; font-size: 0.95rem; font-weight: 700; cursor: pointer; box-shadow: 0 4px 14px rgba(255,92,35,0.35); transition: all 0.2s; }
  .welcome-btn:hover { background: #e84d18; transform: translateY(-1px); }

  /* HELLO BANNER */
  #hello-banner { display: none; background: linear-gradient(90deg, var(--orange), #ff8c5a); color: var(--white); text-align: center; padding: 12px 16px; font-size: 1rem; font-weight: 700; letter-spacing: 0.2px; }
  #hello-banner.show { display: block; }

  /* HEADER */
  .header { background: linear-gradient(135deg, var(--purple) 0%, var(--purple-light) 100%); padding: 28px 24px 22px; text-align: center; position: relative; overflow: hidden; }
  .header::before { content:''; position:absolute; top:-40px; right:-40px; width:160px; height:160px; border-radius:50%; background:rgba(255,92,35,0.18); }
  .header::after { content:''; position:absolute; bottom:-30px; left:-30px; width:120px; height:120px; border-radius:50%; background:rgba(255,92,35,0.12); }
  .header h1 { font-size: 1.5rem; font-weight: 800; color: var(--white); letter-spacing: -0.5px; }
  .header .subtitle { font-size: 0.82rem; font-weight: 500; color: rgba(255,255,255,0.70); margin-top: 4px; text-transform: uppercase; letter-spacing: 1.2px; }

  /* PROGRESS */
  .progress-section { background: var(--white); padding: 16px 20px; box-shadow: var(--shadow-sm); }
  .progress-label { display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: 600; color: var(--purple); margin-bottom: 8px; }
  .progress-track { height: 10px; background: var(--gray-light); border-radius: 99px; overflow: hidden; }
  .progress-fill { height: 100%; background: linear-gradient(90deg, var(--orange), #ff8c5a); border-radius: 99px; transition: width 0.6s cubic-bezier(.4,0,.2,1); }

  /* MOTIVATION */
  .motivation-bar { background: linear-gradient(90deg, var(--green), #0a6655); color: var(--white); text-align: center; padding: 10px 16px; font-size: 0.82rem; font-weight: 500; }

  /* TABS */
  .tabs-wrap { background: var(--white); overflow-x: auto; border-bottom: 2px solid var(--gray-light); position: sticky; top: 0; z-index: 50; box-shadow: var(--shadow-sm); }
  .tabs { display: flex; min-width: max-content; padding: 0 8px; }
  .tab-btn { padding: 14px 16px; font-size: 0.78rem; font-weight: 600; color: var(--gray); background: none; border: none; cursor: pointer; border-bottom: 3px solid transparent; white-space: nowrap; transition: all 0.2s; letter-spacing: 0.3px; }
  .tab-btn:hover { color: var(--purple-light); }
  .tab-btn.active { color: var(--orange); border-bottom-color: var(--orange); }

  /* CONTENT */
  .content { max-width: 780px; margin: 0 auto; padding: 24px 16px 60px; }
  .day-panel { display: none; }
  .day-panel.active { display: block; }

  /* DAY HEADER */
  .day-header { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; }
  .day-number { background: var(--orange); color: var(--white); font-size: 1.1rem; font-weight: 800; width: 52px; height: 52px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 12px rgba(255,92,35,0.3); }
  .day-title { font-size: 1.2rem; font-weight: 700; color: var(--purple); }
  .day-desc { font-size: 0.82rem; color: var(--gray); margin-top: 2px; }

  /* EX CARD */
  .ex-card { background: var(--white); border-radius: var(--radius); padding: 22px; margin-bottom: 20px; box-shadow: var(--shadow); border-left: 4px solid var(--purple-light); }
  .ex-card.grammar { border-left-color: var(--orange); }
  .ex-card.reading { border-left-color: var(--teal); }
  .ex-card.writing { border-left-color: var(--green); }
  .ex-card.challenge { border-left-color: var(--orange); background: linear-gradient(135deg, #fff8f0, #fff); }
  .ex-title { font-size: 0.98rem; font-weight: 700; color: var(--purple); margin-bottom: 4px; }
  .ex-instruction { font-size: 0.82rem; color: var(--gray); margin-bottom: 18px; line-height: 1.5; }

  /* WORD BOX */
  .word-box { background: var(--cream); border-radius: var(--radius-sm); padding: 12px 16px; margin-bottom: 16px; font-size: 0.85rem; font-weight: 600; color: var(--purple); text-align: center; letter-spacing: 0.5px; }

  /* MC */
  .mc-item { margin-bottom: 18px; }
  .mc-question { font-size: 0.88rem; font-weight: 600; color: var(--purple); margin-bottom: 10px; line-height: 1.4; }
  .mc-options { display: flex; flex-direction: column; gap: 8px; }
  .mc-option { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: var(--radius-sm); border: 2px solid var(--gray-light); cursor: pointer; transition: all 0.2s; font-size: 0.85rem; font-weight: 500; background: var(--white); }
  .mc-option:hover { border-color: var(--purple-light); background: #f5f3ff; }
  .mc-option.selected { border-color: var(--purple-light); background: #f5f3ff; }
  .mc-option.correct { border-color: var(--teal); background: #f0fdfa; color: var(--teal); }
  .mc-option.wrong { border-color: var(--red); background: #fef2f2; color: var(--red); }
  .mc-option input[type=radio] { accent-color: var(--purple-light); }

  /* FILL */
  .fill-item { margin-bottom: 14px; }
  .fill-line { display: inline; font-size: 0.88rem; font-weight: 500; color: var(--purple); line-height: 2; }
  .fill-input { border: none; border-bottom: 2px solid var(--purple-light); padding: 2px 6px; font-family: 'Poppins', sans-serif; font-size: 0.88rem; font-weight: 600; color: var(--purple); background: transparent; min-width: 100px; max-width: 160px; width: auto; text-align: center; outline: none; transition: border-color 0.2s; display: inline-block; }
  .fill-input:focus { border-bottom-color: var(--orange); }
  .fill-input.correct { border-bottom-color: var(--teal); color: var(--teal); }
  .fill-input.wrong { border-bottom-color: var(--red); color: var(--red); }
  .fill-input.full { min-width: min(100%,420px); max-width: 100%; text-align: left; }
  .answer-tag { font-size: 0.74rem; font-weight: 700; color: var(--red); margin-left: 8px; }
  .correct-hint { color: var(--teal); font-weight: 700; font-size: 0.78rem; margin-left: 6px; }

  /* TEXTAREA */
  .writing-area { width: 100%; border: 2px solid var(--gray-light); border-radius: var(--radius-sm); padding: 12px 14px; font-family: 'Poppins', sans-serif; font-size: 0.88rem; color: var(--purple); resize: vertical; outline: none; min-height: 120px; transition: border-color 0.2s; margin-bottom: 8px; }
  .writing-area:focus { border-color: var(--purple-light); }

  /* BUTTONS */
  .btn { display: inline-flex; align-items: center; gap: 7px; padding: 10px 20px; border-radius: 99px; font-family: 'Poppins', sans-serif; font-size: 0.82rem; font-weight: 700; cursor: pointer; border: none; transition: all 0.2s; }
  .btn-primary { background: var(--orange); color: var(--white); box-shadow: 0 4px 12px rgba(255,92,35,0.25); }
  .btn-primary:hover { background: #e84d18; transform: translateY(-1px); }
  .btn-secondary { background: var(--gray-light); color: var(--purple); }
  .btn-secondary:hover { background: #e5e7eb; }
  .btn-whatsapp { background: #25D366; color: var(--white); box-shadow: 0 4px 12px rgba(37,211,102,0.25); }
  .btn-whatsapp:hover { background: #1fb855; transform: translateY(-1px); }
  .btn-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }

  /* FEEDBACK */
  .feedback { display: none; padding: 12px 16px; border-radius: var(--radius-sm); font-size: 0.83rem; font-weight: 600; margin-top: 14px; line-height: 1.5; }
  .feedback.show { display: block; }
  .feedback.ok { background: #f0fdfa; color: var(--teal); border: 1px solid #99f6e4; }
  .feedback.err { background: #fef2f2; color: var(--red); border: 1px solid #fecaca; }
  .feedback.partial { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }

  /* READING */
  .reading-text { background: linear-gradient(135deg, var(--cream), #fff5e6); border-radius: var(--radius-sm); padding: 18px; margin-bottom: 18px; font-size: 0.9rem; line-height: 1.75; color: var(--purple); font-weight: 500; border-left: 4px solid var(--teal); }

  /* TF */
  .tf-item { margin-bottom: 10px; }
  .tf-line { display: flex; align-items: center; gap: 10px; font-size: 0.88rem; font-weight: 500; color: var(--purple); flex-wrap: wrap; }
  .tf-btns { display: flex; gap: 6px; }
  .tf-btn { padding: 4px 14px; border-radius: 99px; border: 2px solid var(--gray-light); font-family: 'Poppins', sans-serif; font-size: 0.80rem; font-weight: 700; cursor: pointer; background: var(--white); transition: all 0.2s; }
  .tf-btn.t:hover { border-color: var(--teal); color: var(--teal); }
  .tf-btn.f:hover { border-color: var(--red); color: var(--red); }
  .tf-btn.selected-t { border-color: var(--teal); background: #f0fdfa; color: var(--teal); }
  .tf-btn.selected-f { border-color: var(--red); background: #fef2f2; color: var(--red); }
  .tf-btn.show-correct { outline: 3px solid var(--teal); }

  /* DIALOGUE */
  .dialogue-line { display: flex; align-items: center; gap: 8px; padding: 7px 0; font-size: 0.88rem; font-weight: 500; color: var(--purple); border-bottom: 1px solid rgba(0,0,0,0.06); flex-wrap: wrap; }
  .dialogue-line:last-child { border-bottom: none; }
  .speaker { font-weight: 700; color: var(--orange); flex-shrink: 0; }

  /* CTF */
  .ctf-wordbank { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; padding: 10px 12px; background: var(--cream); border-radius: var(--radius-sm); }
  .ctf-chip { background: var(--purple); color: var(--white); border: none; border-radius: 6px; padding: 5px 14px; font-family: 'Poppins', sans-serif; font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 0.15s; user-select: none; }
  .ctf-chip:hover { background: var(--purple-light); transform: translateY(-1px); }
  .ctf-chip.active { background: var(--orange); outline: 3px solid #ffb347; transform: scale(1.08); }
  .ctf-chip.used { background: var(--gray); cursor: default; opacity: 0.45; }
  .ctf-gap { display: inline-block; min-width: 80px; text-align: center; border-bottom: 2.5px solid var(--purple-light); color: var(--orange); font-weight: 700; font-size: 0.88rem; padding: 0 4px; cursor: pointer; margin: 0 2px; transition: border-color 0.2s, background 0.2s; border-radius: 4px 4px 0 0; vertical-align: middle; line-height: 1.8; }
  .ctf-gap:empty::before { content:'_ _ _'; color:#bbb; font-weight:400; font-size:0.78rem; }
  .ctf-gap.ready { border-bottom-color: var(--orange); background: #fff5ee; }
  .ctf-gap.correct-gap { border-bottom-color: var(--teal); color: var(--teal); background: #f0fdfa; }
  .ctf-gap.wrong-gap { border-bottom-color: var(--red); color: var(--red); background: #fef2f2; }
  .gap-correct-hint { color: var(--teal); font-weight: 700; font-size: 0.76rem; }

  /* SB */
  .sb-words { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; min-height: 38px; padding: 8px; background: var(--gray-light); border-radius: var(--radius-sm); }
  .sb-zone { display: flex; flex-wrap: wrap; gap: 8px; min-height: 44px; padding: 8px 10px; background: var(--white); border: 2px dashed var(--purple-light); border-radius: var(--radius-sm); margin-bottom: 4px; transition: border-color 0.2s; }
  .sb-zone.correct-zone { border-color: var(--teal); background: #f0fdfa; }
  .sb-zone.wrong-zone { border-color: var(--red); background: #fef2f2; }
  .sb-chip { background: var(--purple); color: var(--white); border: none; border-radius: 6px; padding: 5px 12px; font-family: 'Poppins', sans-serif; font-size: 0.82rem; font-weight: 700; cursor: pointer; transition: all 0.15s; user-select: none; }
  .sb-chip:hover { background: var(--purple-light); transform: translateY(-1px); }
  .sb-chip.in-zone { background: var(--orange); }
  .sb-item { margin-bottom: 18px; }
  .sb-label { font-size: 0.75rem; font-weight: 700; color: var(--gray); margin-bottom: 6px; }
  .sb-correct-line { font-size: 0.78rem; color: var(--teal); font-weight: 600; margin-bottom: 4px; }

  /* CLICK MATCH */
  .cm-wrap { display: flex; gap: 14px; flex-wrap: wrap; align-items: flex-start; }
  .cm-col { flex: 1; min-width: min(100%,220px); display: flex; flex-direction: column; gap: 8px; }
  .cm-item { display: flex; align-items: center; gap: 8px; border: 2px solid var(--gray-light); border-radius: var(--radius-sm); padding: 9px 12px; font-size: 0.84rem; font-weight: 600; color: var(--purple); cursor: pointer; background: var(--white); transition: all 0.2s; text-align: left; width: 100%; }
  .cm-item:hover { border-color: var(--purple-light); }
  .cm-item.selected { border-color: var(--orange); background: #fff5ee; }
  .cm-item.linked { border-color: var(--purple-light); background: #f5f3ff; }
  .cm-item.correct { border-color: var(--teal); background: #f0fdfa; color: var(--teal); }
  .cm-item.wrong { border-color: var(--red); background: #fef2f2; color: var(--red); }
  .cm-badge { display: inline-flex; align-items:center; justify-content:center; min-width: 20px; height: 20px; border-radius: 50%; background: var(--purple-light); color: #fff; font-size: 0.7rem; font-weight: 700; flex-shrink: 0; }
  .cm-right .cm-badge { background: var(--orange); }
  .cm-hint { display:block; color: var(--teal); font-weight: 700; font-size: 0.74rem; margin-top: 3px; }

  /* BANK */
  .bank-section { margin-bottom: 28px; }
  .bank-title { font-size: 0.9rem; font-weight: 700; color: var(--purple); margin-bottom: 12px; padding-bottom: 6px; border-bottom: 2px solid var(--gray-light); }
  .vocab-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; }
  .vocab-chip { background: var(--white); border: 2px solid var(--gray-light); border-radius: var(--radius-sm); padding: 10px 12px; text-align: center; font-size: 0.82rem; font-weight: 600; color: var(--purple); cursor: pointer; transition: all 0.2s; }
  .vocab-chip:hover { border-color: var(--purple-light); background: #f5f3ff; }
  .vocab-chip .vc-pt { font-size: 0.72rem; color: var(--gray); font-weight: 500; margin-top: 2px; }
  .grammar-table { width: 100%; border-collapse: collapse; font-size: 0.83rem; }
  .grammar-table th { background: var(--purple); color: var(--white); padding: 8px 12px; text-align: left; font-weight: 600; }
  .grammar-table td { padding: 8px 12px; border-bottom: 1px solid var(--gray-light); color: var(--purple); font-weight: 500; }
  .grammar-table tr:nth-child(even) td { background: var(--cream-light); }
  .grammar-table .orange { color: var(--orange); font-weight: 700; }
  .grammar-table .teal { color: var(--teal); font-weight: 700; }
  .grammar-table .red { color: var(--red); font-weight: 700; }

  /* TIP */
  .tip-box { background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; padding: 12px 16px; font-size: 0.82rem; color: #92400e; margin-top: 12px; line-height: 1.6; }

  /* CHALLENGE / EXAMPLE */
  .challenge-icon { font-size: 2.5rem; text-align: center; margin-bottom: 12px; }
  .example-box { background: linear-gradient(135deg, var(--cream), #fff5e6); border-radius: var(--radius-sm); padding: 16px; margin-top: 14px; font-size: 0.88rem; line-height: 1.8; color: var(--purple); font-weight: 500; border: 2px dashed var(--orange); }
  .example-box .ex-label { font-size: 0.72rem; font-weight: 700; color: var(--orange); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }

  /* LISTEN */
  .listen-btn { background: none; border: none; cursor: pointer; font-size: 1rem; padding: 2px 4px; line-height: 1; opacity: 0.65; transition: opacity 0.2s; vertical-align: middle; }
  .listen-btn:hover { opacity: 1; }

  /* SUMMARY / CONFETTI */
  .summary-card { background: linear-gradient(135deg, var(--purple), var(--purple-light)); border-radius: var(--radius); padding: 24px; text-align: center; color: var(--white); margin-top: 10px; }
  .summary-card h3 { font-size: 1.1rem; font-weight: 800; margin-bottom: 6px; }
  .summary-card p { font-size: 0.82rem; opacity: 0.8; margin-bottom: 16px; }
  .score-big { font-size: 2.8rem; font-weight: 800; color: var(--orange); }
  #confetti-canvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 999; }

  /* RESPONSIVE */
  @media (max-width: 600px) {
    .header h1 { font-size: 1.05rem; }
    .header { padding: 20px 16px 16px; }
    .content { padding: 14px 10px 50px; }
    .ex-card { padding: 14px 12px; }
    .day-header { gap: 10px; margin-bottom: 16px; }
    .day-number { width: 42px; height: 42px; font-size: 0.95rem; }
    .day-title { font-size: 1rem; }
    .tab-btn { padding: 12px 10px; font-size: 0.72rem; }
    .mc-option { font-size: 0.82rem; padding: 8px 10px; }
    .btn { font-size: 0.78rem; padding: 9px 16px; }
    .btn-row { gap: 8px; }
    .fill-input { min-width: 70px; max-width: 120px; font-size: 0.82rem; }
    .grammar-table { font-size: 0.75rem; }
    .grammar-table th, .grammar-table td { padding: 6px 8px; }
    .vocab-grid { grid-template-columns: repeat(auto-fill, minmax(85px, 1fr)); gap: 8px; }
    .reading-text { font-size: 0.85rem; padding: 14px; }
    .tf-line { font-size: 0.82rem; }
    .writing-area { font-size: 0.85rem; }
    .cm-wrap { flex-direction: column; }
  }
</style>
</head>
<body>
<canvas id="confetti-canvas"></canvas>

<!-- WELCOME -->
<div id="welcome-screen">
  <div class="welcome-card">
    <img class="welcome-logo" src="https://raw.githubusercontent.com/cruzmarianagama-ux/logos/main/1%20(3).png" alt="Teacher Mari" onerror="this.style.display='none'"/>
    <div class="welcome-hi">👋 Hello!</div>
    <div class="welcome-sub">Welcome to your<br><strong>End of Course – Weekly Practice</strong>.<br>7 days to review and master Beginner English!<br>What's your name?</div>
    <input class="welcome-input" id="student-name-input" type="text" placeholder="Digite seu nome..." maxlength="40" autocomplete="off"/>
    <button class="welcome-btn" id="welcome-start-btn">Start! 🚀</button>
  </div>
</div>

<div id="hello-banner"></div>

<!-- HEADER -->
<div class="header">
  <div style="display:flex;align-items:center;justify-content:center;gap:18px;flex-wrap:wrap;">
    <img src="https://raw.githubusercontent.com/cruzmarianagama-ux/logos/main/1%20(3).png" alt="Teacher Mari" style="height:72px;object-fit:contain;" onerror="this.style.display='none'"/>
    <div>
      <h1>End of Course – Weekly Practice</h1>
      <div class="subtitle">Beginner</div>
    </div>
  </div>
</div>

<!-- PROGRESS -->
<div class="progress-section">
  <div class="progress-label">
    <span>Progresso da semana</span>
    <span id="progress-pct">0%</span>
  </div>
  <div class="progress-track">
    <div class="progress-fill" id="progress-fill" style="width:0%"></div>
  </div>
</div>

<!-- MOTIVATION -->
<div class="motivation-bar">
  🌟 <span id="motivation-text">You made it to the end! Let's celebrate with great practice!</span>
</div>

<!-- TABS -->
<div class="tabs-wrap">
  <div class="tabs">
