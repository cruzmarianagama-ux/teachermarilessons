    const parts = item.line.split('___');
    let html = `<div class="fill-line">${i+1}. ${parts[0]}`;
    for (let k = 1; k < parts.length; k++) {
      html += `<input class="fill-input" id="${prefix}_${i}_${k-1}" placeholder="...">${parts[k]}`;
    }
    html += ` <span class="answer-tag" id="${prefix}_${i}_tag" style="display:none;"></span></div>`;
    div.innerHTML = html;
    wrap.appendChild(div);
  });
}
function checkFill(data, prefix, fbId, exId) {
  let correct = 0, total = 0;
  data.forEach((item, i) => {
    const answers = Array.isArray(item.ans[0]) ? item.ans : [item.ans];
    let itemOk = true; const wrongAnswers = [];
    answers.forEach((ans, k) => {
      total++;
      const inp = document.getElementById(`${prefix}_${i}_${k}`);
      if (!inp) return;
      inp.classList.remove('correct','wrong');
      const val = inp.value.trim().toLowerCase();
      const ok = Array.isArray(ans) ? ans.map(a=>a.toLowerCase()).includes(val) : val === ans.toLowerCase();
      if (ok) { inp.classList.add('correct'); correct++; }
      else { inp.classList.add('wrong'); itemOk = false; wrongAnswers.push(Array.isArray(ans) ? ans[0] : ans); }
    });
    const tag = document.getElementById(`${prefix}_${i}_tag`);
    if (tag) { if (itemOk) { tag.style.display='none'; } else { tag.textContent=`(correto: ${wrongAnswers.join(', ')})`; tag.style.display='inline'; } }
  });
  const r = scoreText(correct, total);
  showFeedback(fbId, r.msg, r.type);
  incrementChecked(exId);
}
function resetFill(data, prefix, fbId) {
  data.forEach((item, i) => {
    const answers = Array.isArray(item.ans[0]) ? item.ans : [item.ans];
    answers.forEach((_, k) => { const inp = document.getElementById(`${prefix}_${i}_${k}`); if (inp) { inp.value=''; inp.className='fill-input'; } });
