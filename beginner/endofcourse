// ── CLICK MATCH ──
function buildClickMatch(containerId, cfg) {
  const wrap = document.getElementById(containerId);
  wrap.classList.add('cm-wrap');
  const leftDiv = document.createElement('div'); leftDiv.className = 'cm-col cm-left';
  const rightDiv = document.createElement('div'); rightDiv.className = 'cm-col cm-right';
  cfg.left.forEach((t, i) => {
    const b = document.createElement('button'); b.className = 'cm-item'; b.dataset.li = i;
    b.innerHTML = `<span class="cm-badge">${i+1}</span><span>${t}</span>`;
    leftDiv.appendChild(b);
  });
  cfg.right.forEach((t, i) => {
    const b = document.createElement('button'); b.className = 'cm-item'; b.dataset.ri = i;
    b.innerHTML = `<span class="cm-badge">${String.fromCharCode(97+i)}</span><span>${t}</span>`;
    rightDiv.appendChild(b);
  });
  wrap.appendChild(leftDiv); wrap.appendChild(rightDiv);
  const pairs = {}; let selectedLi = null;
  function clearSelection() { leftDiv.querySelectorAll('.cm-item').forEach(b => b.classList.remove('selected')); selectedLi = null; }
  leftDiv.addEventListener('click', e => {
    const btn = e.target.closest('.cm-item'); if (!btn) return;
    const li = btn.dataset.li;
    if (selectedLi === li) { clearSelection(); return; }
    clearSelection(); selectedLi = li; btn.classList.add('selected');
  });
  rightDiv.addEventListener('click', e => {
    const btn = e.target.closest('.cm-item'); if (!btn || selectedLi === null) return;
    const ri = btn.dataset.ri;
    pairs[selectedLi] = ri;
    leftDiv.querySelector(`[data-li="${selectedLi}"]`).classList.remove('selected','correct','wrong');
    leftDiv.querySelector(`[data-li="${selectedLi}"]`).classList.add('linked');
    rightDiv.querySelectorAll('.cm-item').forEach(b => b.classList.remove('linked'));
    Object.values(pairs).forEach(rv => { const rb = rightDiv.querySelector(`[data-ri="${rv}"]`); if (rb) rb.classList.add('linked'); });
    selectedLi = null;
  });
  return { pairs, leftDiv, rightDiv };
}
function checkClickMatch(cfg, state, fbId, exId) {
  let correct = 0;
  cfg.left.forEach((_, i) => {
    const li = String(i);
    const leftBtn = state.leftDiv.querySelector(`[data-li="${li}"]`);
    leftBtn.classList.remove('linked','correct','wrong');
    let hint = leftBtn.querySelector('.cm-hint'); if (hint) hint.remove();
    const chosenRi = state.pairs[li];
    if (chosenRi !== undefined && parseInt(chosenRi) === cfg.answer[i]) { leftBtn.classList.add('correct'); correct++; }
    else {
      leftBtn.classList.add('wrong');
      const hintEl = document.createElement('span'); hintEl.className = 'cm-hint';
      hintEl.textContent = `✓ ${cfg.right[cfg.answer[i]]}`; leftBtn.appendChild(hintEl);
    }
  });
  const r = scoreText(correct, cfg.left.length);
  showFeedback(fbId, r.msg, r.type);
  incrementChecked(exId);
}
function resetClickMatch(state, fbId) {
  Object.keys(state.pairs).forEach(k => delete state.pairs[k]);
  state.leftDiv.querySelectorAll('.cm-item').forEach(b => { b.classList.remove('selected','linked','correct','wrong'); const h = b.querySelector('.cm-hint'); if(h) h.remove(); });
  state.rightDiv.querySelectorAll('.cm-item').forEach(b => b.classList.remove('linked'));
  document.getElementById(fbId).className = 'feedback';
}

// ── OPEN SENTENCES ──
function normalizeSentence(s) { return s.trim().toLowerCase().replace(/\s+/g,' ').replace(/[.!?]+$/,''); }
function buildOpenSentences(containerId, items, prefix, placeholder) {
  const wrap = document.getElementById(containerId);
  const ph = placeholder || 'Write your answer...';
  items.forEach((item, i) => {
    const div = document.createElement('div'); div.className = 'fill-item';
    div.innerHTML = `<div class="fill-line" style="display:block;">${i+1}. <em style="color:var(--purple);font-weight:600;">${item.src}</em></div>
      <input class="fill-input full" id="${prefix}_${i}" placeholder="${ph}">
      <div class="correct-hint" id="${prefix}_${i}_hint" style="display:none;"></div>`;
    wrap.appendChild(div);
  });
}
function checkOpenSentences(items, prefix, fbId, exId) {
  let correct = 0;
  items.forEach((item, i) => {
    const inp = document.getElementById(`${prefix}_${i}`);
    const hint = document.getElementById(`${prefix}_${i}_hint`);
    inp.classList.remove('correct','wrong');
    const val = normalizeSentence(inp.value);
    const ok = item.ans.some(a => normalizeSentence(a) === val);
    if (ok) { inp.classList.add('correct'); correct++; hint.style.display='none'; }
    else { inp.classList.add('wrong'); hint.textContent = `✓ ${item.ans[0]}`; hint.style.display='block'; }
  });
  const r = scoreText(correct, items.length);
  showFeedback(fbId, r.msg, r.type);
  incrementChecked(exId);
}
function resetOpenSentences(items, prefix, fbId) {
  items.forEach((item, i) => {
    const inp = document.getElementById(`${prefix}_${i}`);
    const hint = document.getElementById(`${prefix}_${i}_hint`);
    inp.value=''; inp.className='fill-input full'; hint.style.display='none';
  });
  document.getElementById(fbId).className = 'feedback';
}

// ══════════════════════════════════════════════
//  CTF (Click to Fill)
// ══════════════════════════════════════════════
function buildCTF(cfg) {
  const wrap = document.getElementById(cfg.wrapId);
  const rt = document.createElement('div'); rt.className='reading-text'; rt.id=cfg.rtId;
  let gapIndex = 0;
  const htmlWithGaps = cfg.rtHtml.replace(/___/g, () => {
    const ans = cfg.gapAns[gapIndex]||'';
    const span = `<span class="ctf-gap" data-gi="${gapIndex}" data-ans="${ans}"></span>`;
    gapIndex++; return span;
  });
  rt.innerHTML = htmlWithGaps; wrap.appendChild(rt);
  const bank = document.createElement('div'); bank.className='ctf-wordbank';
  cfg.words.forEach((w, wi) => {
    const btn = document.createElement('button'); btn.className='ctf-chip'; btn.dataset.word=w; btn.dataset.wi=wi; btn.textContent=w; bank.appendChild(btn);
  });
  wrap.appendChild(bank);
  let selected = null;
  bank.addEventListener('click', e => {
    const chip = e.target.closest('.ctf-chip'); if (!chip||chip.classList.contains('used')) return;
    if (selected&&selected.chipEl===chip) { chip.classList.remove('active'); selected=null; rt.querySelectorAll('.ctf-gap').forEach(g=>g.classList.remove('ready')); return; }
    if (selected) selected.chipEl.classList.remove('active');
    chip.classList.add('active'); selected={chipEl:chip,word:chip.dataset.word,wi:chip.dataset.wi};
    rt.querySelectorAll('.ctf-gap').forEach(g=>g.classList.toggle('ready',!g.textContent));
  });
  rt.addEventListener('click', e => {
    const gap = e.target.closest('.ctf-gap'); if (!gap) return;
    gap.classList.remove('correct-gap','wrong-gap','ready');
    const hint=gap.nextElementSibling; if(hint&&hint.classList.contains('gap-correct-hint')) hint.remove();
    if (gap.textContent&&!selected) {
      const returnWi=gap.dataset.filledWi; const chipBack=bank.querySelector(`.ctf-chip[data-wi="${returnWi}"]`);
      if(chipBack) chipBack.classList.remove('used'); gap.textContent=''; gap.dataset.filled=''; gap.dataset.filledWi='';
      rt.querySelectorAll('.ctf-gap').forEach(g=>g.classList.remove('ready')); return;
    }
    if (!selected) return;
    if (gap.textContent) { const oldWi=gap.dataset.filledWi; const chipBack=bank.querySelector(`.ctf-chip[data-wi="${oldWi}"]`); if(chipBack) chipBack.classList.remove('used'); }
    gap.textContent=selected.word; gap.dataset.filled=selected.word; gap.dataset.filledWi=selected.wi;
    selected.chipEl.classList.remove('active'); selected.chipEl.classList.add('used'); selected=null;
    rt.querySelectorAll('.ctf-gap').forEach(g=>g.classList.remove('ready'));
  });
  document.getElementById(cfg.checkId).addEventListener('click', () => {
    let correct=0,total=0;
    rt.querySelectorAll('.ctf-gap').forEach(gap => {
      total++; gap.classList.remove('correct-gap','wrong-gap','ready');
      const oldHint=gap.nextElementSibling; if(oldHint&&oldHint.classList.contains('gap-correct-hint')) oldHint.remove();
      const filled=(gap.textContent||'').trim().toLowerCase(); const ans=(gap.dataset.ans||'').toLowerCase();
      if(filled===ans){gap.classList.add('correct-gap');correct++;}
      else{gap.classList.add('wrong-gap');gap.insertAdjacentHTML('afterend',`<span class="gap-correct-hint"> (${gap.dataset.ans}) </span>`);}
    });
    const r=scoreText(correct,total); showFeedback(cfg.fbId,r.msg,r.type); incrementChecked(cfg.exId);
  });
  document.getElementById(cfg.resetId).addEventListener('click', () => {
    rt.querySelectorAll('.ctf-gap').forEach(gap => {
      gap.textContent=''; gap.dataset.filled=''; gap.dataset.filledWi=''; gap.classList.remove('correct-gap','wrong-gap','ready');
      const hint=gap.nextElementSibling; if(hint&&hint.classList.contains('gap-correct-hint')) hint.remove();
    });
    bank.querySelectorAll('.ctf-chip').forEach(c=>c.classList.remove('used','active')); selected=null;
    document.getElementById(cfg.fbId).className='feedback';
  });
}

